    "@guolao/vue-monaco-editor": "^1.6.0",
    "@master/colors": "^3.0.0",
    "@nuxt/ui": "4.12.0",
    "@pierre/highlights": "^0.2.0",
    "@std/encoding": "jsr:^1.0.11",
    "@std/html": "jsr:^1.0.7",
    "@tailwindcss/language-service": "^0.16.0",
    "@tailwindcss/oxide-wasm32-wasi": "4.3.3",
    "@tailwindcss/root": "github:tailwindlabs/tailwindcss",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "@windpress/lightningcss-wasm": "workspace:*",
    "@windpress/lz-string": "workspace:*",
    "@windpress/oxide-parser": "workspace:*",
    "@wordpress/block-editor": "19.0.0",
    "@wordpress/components": "^43.0.0",
    "@wordpress/i18n": "^7.0.0",
    "autosize": "^6.0.1",
    "browserslist": "^4.29.4",
    "buffer-crc32": "^1.0.0",
