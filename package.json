    "postcss-value-parser": "^4.2.0",
    "pretty-bytes": "^7.2.0",
    "pretty-ms": "^10.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "redaxios": "^0.5.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-intellisense": "github:tailwindlabs/tailwindcss-intellisense",
