    "memfs": "^4.80.0",
    "sass": "npm:sass-embedded@^1.106.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "unplugin-icons": "^24.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "catalog:",
