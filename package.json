{
  "name": "windpress",
  "version": "3.3.92",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "pnpm build:oxide && pnpm build:lightningcss && vp build",
    "build:oxide": "pnpm --filter @windpress/oxide-parser build:wasm",
    "build:lightningcss": "pnpm --filter @windpress/lightningcss-wasm build:wasm",
    "typecheck:packages": "tsc --noEmit -p resources/packages/tsconfig.json",
    "lint": "vp lint ./resources",
    "format": "vp lint --fix ./resources",
    "test": "pnpm --filter @windpress/lz-string --filter @windpress/lightningcss-wasm --filter @windpress/oxide-parser test",
    "test:scan": "vitest run --config resources/packages/core/windpress/vitest.config.ts",
    "release": "node deploy/release.mjs"
  },
  "dependencies": {
    "@adobe/css-tools": "^4.5.0",
    "@ampproject/remapping": "^2.3.0",
    "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
