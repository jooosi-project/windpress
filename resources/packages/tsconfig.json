{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals"],
    "skipLibCheck": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "lz-string/src/**/*.ts",
    "oxide-parser/src/**/*.ts",
    "oxide-parser/pkg/**/*.d.ts",
    "vitest.config.ts"
  ]
}
